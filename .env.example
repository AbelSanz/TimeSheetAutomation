# Base URL for the timesheet application
TIMESHEET_URL=https://peoplehub.contoso.com

# Time entries per day (HH:MM format)
# You can customize times for each day individually

# Monday
MONDAY_START_TIME_1=08:30
MONDAY_END_TIME_1=14:00
MONDAY_START_TIME_2=14:45
MONDAY_END_TIME_2=17:00

# Tuesday
TUESDAY_START_TIME_1=08:30
TUESDAY_END_TIME_1=14:00
TUESDAY_START_TIME_2=14:45
TUESDAY_END_TIME_2=17:00

# Wednesday
WEDNESDAY_START_TIME_1=08:30
WEDNESDAY_END_TIME_1=14:00
WEDNESDAY_START_TIME_2=14:45
WEDNESDAY_END_TIME_2=17:00

# Thursday
THURSDAY_START_TIME_1=08:30
THURSDAY_END_TIME_1=14:00
THURSDAY_START_TIME_2=14:45
THURSDAY_END_TIME_2=17:00

# Friday
FRIDAY_START_TIME_1=08:30
FRIDAY_END_TIME_1=14:00
FRIDAY_START_TIME_2=14:45
FRIDAY_END_TIME_2=17:00

# Special day indicators (CSS classes)
SPECIAL_DAY_INDICATOR_HOLIDAY=wx-timesheet-day__indicator-holiday
SPECIAL_DAY_INDICATOR_VACATION_APPROVED=wx-timesheet-day__indicator-vacation-approved
SPECIAL_DAY_INDICATOR_ABSENCE_APPROVED=wx-timesheet-day__indicator-absence-approved

# Half-day entries
MORNING_ONLY_START_TIME_1=08:30
MORNING_ONLY_END_TIME_1=12:30
AFTERNOON_ONLY_START_TIME_1=13:00
AFTERNOON_ONLY_END_TIME_1=17:00

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
